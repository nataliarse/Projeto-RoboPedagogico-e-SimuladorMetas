# Modelo local usado pelo Ollama para gerar respostas.
OLLAMA_MODEL=llama3.2:1b

# Endereco da API local do Ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Temperatura enviada ao Ollama.
OLLAMA_TEMPERATURE=0.2

# Quando true, imprime os contratos JSON entre os agentes no terminal.
DEBUG_MODE=true
