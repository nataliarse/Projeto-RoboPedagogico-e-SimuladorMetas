# Interface do Robô Orientador servida pelo nginx sob /robo-orientador/.
# Contexto de build: raiz do repositório.
FROM public.ecr.aws/docker/library/node:22-alpine AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npx ng build --configuration production --base-href /robo-orientador/

FROM public.ecr.aws/nginx/nginx:stable-alpine
COPY deploy/eks/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/meu-primeiro-app/browser/ /usr/share/nginx/html/robo-orientador/
EXPOSE 80
