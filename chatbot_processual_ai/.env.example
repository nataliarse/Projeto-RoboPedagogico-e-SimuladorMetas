OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL_SELECTION=auto
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=60

# Relative paths are resolved from chatbot_processual_ai/.
LOCAL_DB_PATH=data/processual.sqlite3
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=processual_chunks
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# Local backend do simulador de metas (não usar URL institucional).
SIMULATOR_API_URL=http://127.0.0.1:8001
SIMULATOR_TIMEOUT_SECONDS=20

# Optional external browser executable for the collector. Without it, the
# collector uses the Chromium installed by Playwright.
# TRT18_COLLECTOR_BROWSER_EXECUTABLE=
