OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_MODEL_SELECTION=auto
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT_SECONDS=60

# Relative paths are resolved from chatbot_processual_ai/.
LOCAL_DB_PATH=data/processual.sqlite3
RAG_ENABLED=true
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=processual_chunks
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_MIN_SCORE=0.35

# Modelo de linguagem: "ollama" (local) ou "bedrock" (Amazon Bedrock, API Converse).
# Credenciais do Bedrock: instance profile na EC2 ou perfil do `aws configure` localmente.
LLM_PROVIDER=ollama
LLM_FALLBACK_OLLAMA=true
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_TEMPERATURE=0.2
BEDROCK_MAX_TOKENS=1024
# Auditoria das chamadas (hash do prompt e da resposta; texto integral só com FULL_TEXT=true).
LLM_AUDIT_LOG=data/logs/llm_auditoria.jsonl
LLM_AUDIT_FULL_TEXT=false

# Busca no glossário das metas: "qdrant" (local) ou "pgvector" (banco da IESB).
# Com pgvector, a senha vem do secret TCC_SECRET_ID; NORMAS_PG_URL só para uso local.
NORMAS_BACKEND=qdrant
TCC_SECRET_ID=tcc/leonardo-a-pereira/db
NORMAS_PG_SCHEMA=tcc_leonardo_a_pereira
# NORMAS_PG_URL=
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
NORMAS_MIN_SCORE=0.30

# Optional external browser executable for the collector. Without it, the
# collector uses the Chromium installed by Playwright.
# TRT18_COLLECTOR_BROWSER_EXECUTABLE=
